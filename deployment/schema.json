    },
    "graphql.indentStyle": {
      "$ref": "#/definitions/indentStyle",
      "x-overrides": "indentStyle"
    },
    "graphql.bracketSpacing": {
      "description": "Surround the inner contents of some braces with spaces.",
      "default": true,
      "type": "boolean",
      "x-overrides": "bracketSpacing",
      "x-example": {
        "config": { "graphql.enabled": true },
        "extension": "graphql",
        "input": [
          "query {",
          "  users(filter: {role: ADMIN}) {",
          "    name",
          "  }",
          "}"
        ]
      }
    },
    "javascript.delimiterSpacing": {
      "description": "Insert spaces inside single-line delimiters.",
      "type": "boolean",
      "default": false,
      "x-example": {
        "input": [
          "const list = [1, 2];",
          "call(a, b);"
        ]
      }
    },
    "javascript.trailingNewline": {
      "description": "Add a trailing newline at the end of the file.",
      "type": "boolean",
      "default": true
    },
    "javascript.attributePosition": {
      "description": "Control the placement of JSX attributes.",
      "type": "string",
      "default": "auto",
      "oneOf": [{
        "const": "auto",
        "description": "Attributes are only put on separate lines when the element doesn't fit on a line."
