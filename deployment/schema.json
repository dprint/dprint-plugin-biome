    "css.cssModules": {
      "description": "Enable CSS modules support (enables `:local` and `:global` selectors).",
      "default": false,
      "type": "boolean"
    },
    "css.tailwindDirectives": {
      "description": "Enable parsing of Tailwind CSS 4.0 directives and functions.",
      "default": false,
      "type": "boolean"
    },
    "graphql.trailingNewline": {
      "description": "Add a trailing newline at the end of the file.",
      "type": "boolean",
      "default": true
    },
    "graphql.enabled": {
      "description": "Enable graphql formatting.",
      "default": false,
      "type": "boolean"
    },
