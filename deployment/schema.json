{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plugins.dprint.dev/dprint/dprint-plugin-biome/0.0.0/schema.json",
  "type": "object",
  "x-playground": {
    "input": [
      "import {readFile} from 'node:fs/promises'",
      "",
      "type Task={id:number,title:string,done:boolean,tags?:string[]}",
      "",
      "export async function loadTasks(path:string):Promise<Task[]>{",
      "const text=await readFile(path,'utf8')",
      "    return JSON.parse(text).map((item:Task)=>({...item,done:item.done??false}))",
      "}",
      "",
      "export class TaskStore{",
      "  private tasks=new Map<number,Task>()",
      "  add(task:Task){this.tasks.set(task.id,task);return this}",
      "  pending(){return [...this.tasks.values()].filter(t=>!t.done)}",
      "}",
      "",
      "const store=new TaskStore().add({id:1,title:'Write docs',done:false}).add({id:2,title:\"Ship release\",done:true,tags:['release']})",
      "console.log(`${store.pending().length} tasks left`)"
    ]
  },
  "x-sections": [{
    "title": "General",
    "description": "The width, indentation, line endings, quotes, and brace spacing of every language.",
    "properties": [
      "lineWidth",
      "indentWidth",
      "indentStyle",
      "lineEnding",
      "quoteStyle",
      "bracketSpacing"
    ]
  }, {
    "title": "JavaScript and TypeScript",
    "description": "The options for JavaScript, TypeScript, JSX, and TSX files.",
    "properties": [
      "javascript.enabled",
      "typescript.enabled",
      "semicolons",
      "trailingCommas",
      "arrowParentheses",
      "quoteProperties",
      "javascript.expand",
      "javascript.operatorLinebreak",
      "javascript.delimiterSpacing",
      "javascript.trailingNewline"
    ]
  }, {
    "title": "JSX",
    "description": "The quotes, attributes, and brackets of JSX elements.",
    "properties": [
      "jsxQuoteStyle",
      "javascript.attributePosition",
      "bracketSameLine"
    ]
  }, {
    "title": "JSON",
    "description": "The options for JSON and JSONC files.",
    "properties": [
      "json.enabled",
      "jsonc.enabled",
      "json.expand",
      "json.trailingCommas",
      "json.delimiterSpacing",
      "json.trailingNewline"
